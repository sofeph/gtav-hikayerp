<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GTML Test Sayfası</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: #121622;
            color: #e8eefc;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 400px;
            margin: 0 auto;
        }
        .card {
            background: #1c2030;
            border: 1px solid #2a2f3f;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }
        .card h1 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #a8c7fa;
        }
        .card p {
            font-size: 14px;
            line-height: 1.5;
            color: #9aa4b8;
            margin-bottom: 16px;
        }
        .badge {
            display: inline-block;
            background: #203a5c;
            color: #a8c7fa;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 16px;
        }
        .btn {
            display: block;
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #2a3f5f 0%, #1e2d42 100%);
            border: 1px solid #3a5a7a;
            border-radius: 12px;
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            transition: all 0.2s ease;
        }
        .btn:hover {
            background: linear-gradient(135deg, #3a5a7a 0%, #2a3f5f 100%);
            border-color: #4a7ab8;
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(42, 63, 95, 0.4);
        }
        .btn:active {
            transform: translateY(0);
        }
        .btn-primary {
            background: linear-gradient(135deg, #1e3a5f 0%, #152a3f 100%);
            border-color: #2a5a8a;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #2a5a8a 0%, #1e3a5f 100%);
            border-color: #3a7ac8;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #2a2f3f;
        }
        .info-row:last-child {
            border-bottom: none;
        }
        .info-label {
            color: #9aa4b8;
            font-size: 13px;
        }
        .info-value {
            color: #e8eefc;
            font-size: 13px;
            font-weight: 500;
        }
        .flex-row {
            display: flex;
            gap: 12px;
        }
        .flex-row .btn {
            flex: 1;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h1>GTML Test Sayfası</h1>
            <p>Bu sayfa Faz 2 WebV2/GTML motoru ile render ediliyor. Companion'da BeautifulSoup4 layout hesaplıyor, sadece Display List JSON (2-5 KB) oyun içine gönderiliyor.</p>
            <span class="badge">WebV2 / GTML</span>
        </div>
        
        <div class="card">
            <h1>Bilgi Paneli</h1>
            <div class="info-row">
                <span class="info-label">Motor</span>
                <span class="info-value">GTML (WebV2)</span>
            </div>
            <div class="info-row">
                <span class="info-label">Render</span>
                <span class="info-value">ImGui DrawList (Native)</span>
            </div>
            <div class="info-row">
                <span class="info-label">Layout</span>
                <span class="info-value">BeautifulSoup4 (statik)</span>
            </div>
            <div class="info-row">
                <span class="info-label">Veri Boyutu</span>
                <span class="info-value">~2-5 KB JSON</span>
            </div>
        </div>
        
        <div class="card">
            <h1>Dış API Testi</h1>
            <p>Butona basarak dış dünyadan veri çekme (fetch) test edin:</p>
            <div class="flex-row">
                <button class="btn btn-primary" id="btn-time">Saat Al (worldtimeapi)</button>
                <button class="btn" id="btn-ip">IP Al (ipify)</button>
            </div>
            <div id="api-result" style="margin-top: 12px; padding: 12px; background: #0f131a; border-radius: 8px; font-size: 12px; font-family: monospace; display: none;"></div>
        </div>
        
        <div class="card">
            <h1>Oyun İçi Eylem Testi</h1>
            <p>Butona basarak gta.trigger ile oyun içi sisteme olay gönderin:</p>
            <button class="btn" id="btn-gta-trigger">Ekonomi: Para Ekle (Test)</button>
            <div id="trigger-result" style="margin-top: 12px; padding: 12px; background: #0f131a; border-radius: 8px; font-size: 12px; display: none;"></div>
        </div>
    </div>

    <script>
        // window.gta.trigger ASI (QuickJS) tarafından sağlanır

        // API Test Butonları
        const apiResult = document.getElementById('api-result');
        const triggerResult = document.getElementById('trigger-result');

        document.getElementById('btn-time').addEventListener('click', async () => {
            apiResult.style.display = 'block';
            apiResult.textContent = 'Yükleniyor...';
            try {
                const res = await fetch('http://worldtimeapi.org/api/timezone/Europe/Istanbul');
                const data = await res.json();
                apiResult.textContent = `Saat: ${data.datetime}\nTimezone: ${data.timezone}`;
            } catch (e) {
                apiResult.textContent = `Hata: ${e.message}`;
            }
        });

        document.getElementById('btn-ip').addEventListener('click', async () => {
            apiResult.style.display = 'block';
            apiResult.textContent = 'Yükleniyor...';
            try {
                const res = await fetch('https://api.ipify.org?format=json');
                const data = await res.json();
                apiResult.textContent = `IP: ${data.ip}`;
            } catch (e) {
                apiResult.textContent = `Hata: ${e.message}`;
            }
        });

        // gta.trigger Test
        document.getElementById('btn-gta-trigger').addEventListener('click', () => {
            triggerResult.style.display = 'block';
            triggerResult.textContent = 'Olay gönderiliyor...';
            window.gta.trigger('test:para_ekle', { 
                amount: 50000, 
                source: 'gtml_test' 
            });
            setTimeout(() => {
                triggerResult.textContent = 'Olay gönderildi: test:para_ekle\n{ amount: 50000, source: "gtml_test" }';
            }, 500);
        });

        console.log('GTML Test Sayfası yüklendi');
    </script>
</body>
</html>